\lstdefinestyle{cpp}{
    style=code,
    language=C++,
    morekeywords={nullptr, constexpr, auto, override, final, noexcept, decltype, thread_local},
}

% === Java ===
\lstdefinestyle{java}{
    style=code,
    language=Java,
    morekeywords={var, record, sealed, permits, yield},
}

% === JavaScript/TypeScript ===
