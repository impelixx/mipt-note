% =============================================================================
% LECTURE NOTES STYLE PACKAGE
% =============================================================================
% Минималистичный стиль для конспектов лекций
%
% КОМПИЛЯЦИЯ: XeLaTeX или LuaLaTeX
%   xelatex main.tex
%   lualatex main.tex
%
% =============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style}[2025/01/21 Lecture Notes Style]

% =============================================================================
% БАЗОВЫЕ ПАКЕТЫ
% =============================================================================

\RequirePackage[
    a4paper,
    top=2cm,
    bottom=2cm,
    left=2.5cm,
    right=2.5cm,
    headheight=14pt,
    includehead,
    includefoot
]{geometry}

\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\setdefaultlanguage{russian}
\setotherlanguage{english}

\RequirePackage{microtype}
\RequirePackage{setspace}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{mathtools}
\RequirePackage[table]{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{listings}
\RequirePackage{hyperref}
\RequirePackage{bookmark}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{tocloft}
\RequirePackage[most]{tcolorbox}
\RequirePackage{etoolbox}
\RequirePackage{calc}

% =============================================================================
% ЦВЕТОВАЯ ПАЛИТРА (сдержанная)
% =============================================================================

\definecolor{primary}{RGB}{50, 50, 50}           % Тёмно-серый
\definecolor{secondary}{RGB}{100, 100, 100}      % Средне-серый
\definecolor{accent}{RGB}{70, 90, 120}           % Приглушённый синий
\definecolor{lightgray}{RGB}{245, 245, 245}      % Светлый фон
\definecolor{rule}{RGB}{200, 200, 200}           % Линии

% =============================================================================
% ШРИФТЫ
% =============================================================================
% Основной шрифт: PT Serif (качественный шрифт с поддержкой кириллицы)
% Sans: PT Sans
% Код: JetBrains Mono
%
% Альтернативы если шрифты не установлены:
%   - Serif: Times New Roman, Liberation Serif, STIX Two Text
%   - Sans: Helvetica, Arial
%   - Mono: Menlo, Consolas, Fira Code

\setmainfont{PT Serif}[
    Ligatures=TeX
]

\setsansfont{PT Sans}[
    Ligatures=TeX,
    Scale=0.95
]

\setmonofont{JetBrains Mono}[
    Scale=0.85
]

% Шрифты для кириллицы (требуется для polyglossia)
\newfontfamily\cyrillicfont{PT Serif}[Ligatures=TeX]
\newfontfamily\cyrillicfontsf{PT Sans}[Ligatures=TeX,Scale=0.95]
\newfontfamily\cyrillicfonttt{JetBrains Mono}[Scale=0.85]

% =============================================================================
% МЕТАДАННЫЕ ДОКУМЕНТА
% =============================================================================

\newcommand{\coursename}{Название курса}
\newcommand{\coursesubtitle}{Конспекты лекций}
\newcommand{\studentname}{Имя студента}
\newcommand{\teachername}{Имя преподавателя}
\newcommand{\institution}{Университет}
\newcommand{\semester}{Осень 2025}

\newcommand{\setcoursename}[1]{\renewcommand{\coursename}{#1}}
\newcommand{\setcoursesubtitle}[1]{\renewcommand{\coursesubtitle}{#1}}
\newcommand{\setstudentname}[1]{\renewcommand{\studentname}{#1}}
\newcommand{\setteachername}[1]{\renewcommand{\teachername}{#1}}
\newcommand{\setinstitution}[1]{\renewcommand{\institution}{#1}}
\newcommand{\setsemester}[1]{\renewcommand{\semester}{#1}}

% =============================================================================
% ТИПОГРАФИКА
% =============================================================================

\setstretch{1.3}
\setlength{\parindent}{1.25em}
\setlength{\parskip}{0.4ex plus 0.2ex minus 0.1ex}

% =============================================================================
% ТИТУЛЬНАЯ СТРАНИЦА (сдержанный стиль)
% =============================================================================

\newcommand{\maketitlepage}{%
    \begin{titlepage}
        \newgeometry{top=4cm, bottom=3cm, left=3cm, right=3cm}
        \begin{center}
            {\small\color{secondary}\institution}

            \vspace{0.3cm}
            {\color{rule}\rule{3cm}{0.5pt}}

            \vfill

            {\LARGE\bfseries\coursename}

            \vspace{0.5cm}
            {\large\color{secondary}\coursesubtitle}

            \vfill

            \begin{tabular}{rl}
                {\small\color{secondary}Студент:} & \studentname \\[0.3em]
                {\small\color{secondary}Преподаватель:} & \teachername \\
            \end{tabular}

            \vspace{2cm}

            {\color{rule}\rule{4cm}{0.5pt}}

            \vspace{0.3cm}
            {\small\color{secondary}\semester}
        \end{center}
        \restoregeometry
    \end{titlepage}
}

% =============================================================================
% КОЛОНТИТУЛЫ
% =============================================================================

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{secondary}\coursename}
\fancyhead[R]{\small\color{secondary}\leftmark}
\fancyfoot[C]{\small\color{secondary}\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\renewcommand{\headrule}{{\color{rule}\hrule width\headwidth height\headrulewidth}}

\fancypagestyle{plain}{%
    \fancyhf{}
    \fancyfoot[C]{\small\color{secondary}\thepage}
    \renewcommand{\headrulewidth}{0pt}
}

% =============================================================================
% ЗАГОЛОВКИ СЕКЦИЙ
% =============================================================================

\titleformat{\section}
    {\large\bfseries\color{primary}}
    {\thesection.}
    {0.5em}
    {}

\titleformat{\subsection}
    {\normalsize\bfseries\color{primary}}
    {\thesubsection.}
    {0.5em}
    {}

\titleformat{\subsubsection}
    {\normalsize\itshape\color{primary}}
    {\thesubsubsection.}
    {0.5em}
    {}

\titlespacing*{\section}{0pt}{2ex plus 0.5ex}{1ex plus 0.2ex}
\titlespacing*{\subsection}{0pt}{1.5ex plus 0.3ex}{0.8ex plus 0.1ex}
\titlespacing*{\subsubsection}{0pt}{1ex plus 0.2ex}{0.5ex plus 0.1ex}

% =============================================================================
% КОМАНДА ЛЕКЦИИ
% =============================================================================
% Использование: \lecture{1}{Название лекции}

\newcounter{lecturenum}
\newcommand{\lecture}[2]{%
    \setcounter{lecturenum}{#1}%
    \setcounter{section}{0}%
    \newpage
    \phantomsection
    \addcontentsline{toc}{section}{Лекция #1. #2}
    \markboth{Лекция #1}{Лекция #1}

    \begin{center}
        {\color{rule}\rule{2cm}{0.5pt}}
        \vspace{0.5em}

        {\Large\bfseries Лекция #1}

        \vspace{0.3em}
        {\large #2}

        \vspace{0.5em}
        {\color{rule}\rule{2cm}{0.5pt}}
    \end{center}
    \vspace{1em}
}

% Дата лекции
\newcommand{\lecturedate}[1]{%
    \hfill{\small\color{secondary}#1}\par\vspace{0.5em}
}

% =============================================================================
% ОГЛАВЛЕНИЕ
% =============================================================================

\renewcommand{\cfttoctitlefont}{\large\bfseries}
\renewcommand{\cftaftertoctitle}{\par\noindent{\color{rule}\rule{\textwidth}{0.5pt}}\vspace{0.5em}}
\renewcommand{\cftsecfont}{\normalfont}
\renewcommand{\cftsecpagefont}{\normalfont}
\renewcommand{\cftsecleader}{\cftdotfill{\cftsecdotsep}}
\renewcommand{\cftsecdotsep}{\cftdotsep}

% =============================================================================
% СПИСКИ
% =============================================================================

\setlist{
    topsep=0.3ex,
    itemsep=0.2ex,
    parsep=0.1ex,
    leftmargin=1.5em
}

\setlist[itemize,1]{label={\small\textbullet}}
\setlist[itemize,2]{label={\small--}}
\setlist[enumerate,1]{label={\arabic*.}}
\setlist[enumerate,2]{label={\alph*)}}

% =============================================================================
% ТЕОРЕМЫ И ОПРЕДЕЛЕНИЯ
% =============================================================================

\theoremstyle{plain}
\newtheorem{theorem}{Теорема}[section]
\newtheorem{lemma}[theorem]{Лемма}
\newtheorem{proposition}[theorem]{Утверждение}
\newtheorem{corollary}[theorem]{Следствие}

\theoremstyle{definition}
\newtheorem{definition}{Определение}[section]
\newtheorem{example}{Пример}[section]

\theoremstyle{remark}
\newtheorem*{remark}{Замечание}
\newtheorem*{note}{Примечание}

\renewcommand{\qedsymbol}{$\square$}

% Боксы для теорем/определений
\newtcolorbox{thmbox}{
    colback=lightgray,
    colframe=rule,
    boxrule=0.5pt,
    arc=0pt,
    left=0.8em,
    right=0.8em,
    top=0.6em,
    bottom=0.6em,
    boxsep=0pt,
    before skip=0.8em,
    after skip=0.8em
}

\newtcolorbox{defbox}{
    colback=white,
    colframe=rule,
    boxrule=0.5pt,
    arc=0pt,
    left=0.8em,
    right=0.8em,
    top=0.6em,
    bottom=0.6em,
    boxsep=0pt,
    before skip=0.8em,
    after skip=0.8em,
    borderline west={2pt}{0pt}{accent}
}

